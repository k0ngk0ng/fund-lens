# 复制为 .env 后按需修改：  cp .env.example .env
# .env 不会进版本库，也不会打进镜像；compose 通过 env_file 注入容器。

# cookie 签名密钥，务必改成长随机串：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# 首次启动且数据库为空时，自动创建的管理员（明文，程序内部 hash）
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# 刷新与数据
REFRESH_INTERVAL=10            # 盘中刷新间隔（秒）
HOLDINGS_SOURCE=auto          # auto | akshare | eastmoney
VALUATION_METHOD=normalized    # normalized | raw
DB_PATH=/app/data/fundlens.db
TZ=Asia/Shanghai

# 宿主机映射端口
PORT=8000
